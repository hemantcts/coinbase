# ---- Account -----------------------------------------------------------------
# What the owner thinks in and what the pairs settle in. CHF -> EUR is converted
# once at start with a recorded rate; every snapshot stores the rate it used.
REPORT_CURRENCY=CHF
QUOTE_CURRENCY=EUR
STARTING_CAPITAL=1000

# ---- Markets and strategy ------------------------------------------------------
PRODUCTS=BTC-EUR,ETH-EUR
# Candle size in seconds. 21600 (6 h) is the only timeframe that stayed positive after
# fees in testing; 300 and 3600 lost money with every strategy. Coinbase offers
# 60, 300, 900, 3600, 21600, 86400.
GRANULARITY=21600
# How often to check for a newly closed candle (the engine acts once per candle).
POLL_SECONDS=300
# trendhold (recommended: EMA 20/100 on 6h candles, see docs/RESEARCH-2026-10.md) | trend | momentum | mean_reversion | ensemble
STRATEGY=trendhold
# client | low | medium | high
#   client = the client's preliminary limits of 16 Oct 2026: 10 % per position, 30 % invested, 2 % daily, 8 % total
#   medium = the first brief: 25 % / 60 % / 2 % / 8 %
RISK_PROFILE=client
# Market data older than this (seconds) blocks new buys. 0 = two candles.
MAX_DATA_AGE=0

# ---- Costs assumed by the simulator and the edge filter -----------------------
# Coinbase entry tier, the worst case for a small account: maker 0.6 %, taker 1.2 %.
# Entries and planned exits are post-only (maker); stop-loss and flatten are marketable (taker).
# `trader verify-live` prints the account's real tier; live mode never assumes a cheaper one.
FEE_RATE=0.006
TAKER_FEE_RATE=0.012
SLIPPAGE_RATE=0.001

# ---- Loss-limit policy (decision of 2026-10-16, see docs/RESEARCH-2026-10.md section 7) ----
# After the total loss limit trips, trading pauses this many days, then resumes with the
# limit re-based on the current equity. 0 = stay halted until restarted by hand.
HALT_RESET_DAYS=30

# ---- Live order handling ------------------------------------------------------------
# An unfilled post-only order is cancelled after ORDER_TIMEOUT seconds and re-priced up to
# ORDER_RETRIES times; the last attempt is marketable so the decision is not lost.
ORDER_TIMEOUT=180
ORDER_RETRIES=2

# ---- Storage ---------------------------------------------------------------------
DATA_DIR=/data
# DB_PATH=/data/trader.sqlite3

# ---- FX fallback (only used if api.frankfurter.app is unreachable) ----------------
# FX_FALLBACK_RATE=1.05

# ---- Dashboard -------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Host port the container is published on (127.0.0.1 only); the reverse proxy points here.
DASHBOARD_BIND_PORT=8090
# Required for the STOP / FLATTEN / DISARM buttons. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=

# ---- Alerts (optional): any webhook that accepts JSON, e.g. Slack/Discord/n8n ----
NOTIFY_WEBHOOK=

# ---- Live trading: leave false. Real orders also need data/LIVE_ARMED and a passed gate. ----
LIVE_TRADING=false
# COINBASE_API_KEY=organizations/.../apiKeys/...
# COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
