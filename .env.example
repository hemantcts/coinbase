# ---- Account -----------------------------------------------------------------
# What the owner thinks in and what the pairs settle in. CHF -> EUR is converted
# once at start with a recorded rate; every snapshot stores the rate it used.
REPORT_CURRENCY=CHF
QUOTE_CURRENCY=EUR
STARTING_CAPITAL=1000

# ---- Markets and strategy ------------------------------------------------------
PRODUCTS=BTC-EUR,ETH-EUR
GRANULARITY=300
POLL_SECONDS=300
# trend | momentum | mean_reversion | ensemble
STRATEGY=ensemble
# low | medium | high   (medium = the brief: 250/600/400/5/20/80, max 4 new positions per day)
RISK_PROFILE=medium

# ---- Costs assumed by the simulator and the edge filter -----------------------
# Read the real fee tier from the Coinbase account before going live.
FEE_RATE=0.006
SLIPPAGE_RATE=0.001

# ---- Storage ---------------------------------------------------------------------
DATA_DIR=/data
# DB_PATH=/data/trader.sqlite3

# ---- FX fallback (only used if api.frankfurter.app is unreachable) ----------------
# FX_FALLBACK_RATE=1.05

# ---- Dashboard -------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Required for the STOP / FLATTEN / DISARM buttons. Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=

# ---- Alerts (optional): any webhook that accepts JSON, e.g. Slack/Discord/n8n ----
NOTIFY_WEBHOOK=

# ---- Live trading: leave false. Real orders also need data/LIVE_ARMED and a passed gate. ----
LIVE_TRADING=false
# COINBASE_API_KEY=organizations/.../apiKeys/...
# COINBASE_API_SECRET=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----\n
